# ── Supabase (zorunlu) ──
# Supabase projeni oluşturduktan sonra Project Settings → API'den al.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...          # public anon key (tarayıcıda kullanılır)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...              # gizli service role key (SADECE sunucuda kullanılır)

# ── Site URL (önerilir — Render/Railway gibi reverse-proxy arkasında
#    çalışan platformlarda gerekli) ──
# Render gibi platformlarda uygulama dışarıya https://xxx.onrender.com
# olarak görünür ama içeride http://localhost:PORT'u dinler. Google girişi
# ve çıkışı sonrası doğru adrese yönlendirebilmek için gerçek, herkese açık
# adresini buraya yaz (sonunda / OLMADAN). Boş bırakılırsa uygulama önce
# proxy'nin X-Forwarded-Host header'ına güvenir; bu da yoksa (nadiren)
# yanlışlıkla iç adrese (localhost) yönlendirebilir.
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# ── Finnhub (opsiyonel — forex/hisse/kripto haberleri için) ──
# https://finnhub.io adresinden ücretsiz key alabilirsin.
FINNHUB_API_KEY=

# ── Gemini (opsiyonel — haber AI özetleri için) ──
# https://aistudio.google.com/app/apikey adresinden ücretsiz key alabilirsin.
GEMINI_API_KEY=

# ── Telegram Bot (opsiyonel — bildirimler için) ──
# Kurulum adımları: uygulama içinde Ayarlar > Telegram kutusuna tıkla,
# ya da README.md dosyasındaki "Telegram Bot Kurulumu" bölümüne bak.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ⚠️ ZORUNLU: TELEGRAM_BOT_TOKEN tanımlıysa bu da MUTLAKA tanımlanmalı.
# Boş bırakılırsa /api/telegram/webhook, /notify ve /digest endpoint'leri
# artık "açık" kalmaz — tüm istekleri 503 ile reddeder. Rastgele, uzun bir
# değer üret: `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=

# ── Google ile Giriş (opsiyonel — kaydedilen haberleri cihazlar arası
#    senkronlamak için) ──
# Kurulum:
#   1) Supabase Dashboard → Authentication → Providers → Google'ı aç.
#   2) Google Cloud Console'da bir OAuth 2.0 Client ID oluştur, "Authorized
#      redirect URI" olarak Supabase'in verdiği callback URL'ini
#      (https://<proje-ref>.supabase.co/auth/v1/callback) ekle.
#   3) Client ID / Secret'ı Supabase'teki Google provider ayarına yapıştır.
#   4) Yukarıdaki NEXT_PUBLIC_SITE_URL'i doğru doldur (Render gibi
#      reverse-proxy arkasındaki platformlarda giriş/çıkış sonrası
#      localhost'a yönlenme sorununu önler).
#   5) supabase/auth_and_rls_migration.sql dosyasını Supabase SQL Editor'de
#      çalıştırmayı unutma (user_saved_news tablosu + RLS politikaları için).

# ── "Kendi Botunu Bağla" özelliği (opsiyonel) ──
# Kullanıcıların kendi Telegram bot token'larını siteye ekleyip site
# fonksiyonlarını (haber/takvim bildirimi, /filtre, /durum, ⭐ kaydetme)
# kendi botlarında kullanabilmesi için:
#   1) supabase/user_bots_migration.sql dosyasını Supabase SQL Editor'de
#      çalıştır (telegram_migration.sql VE auth_and_rls_migration.sql'den
#      SONRA). Bu, Supabase Vault'u aktif eder ve token'ları şifreli saklar.
#   2) Yeni bir env değişkeni GEREKMEZ — şifreleme anahtarı Vault
#      içinde kalır, uygulama koduna hiç çıkmaz.
#   3) NEXT_PUBLIC_SITE_URL doğru dolu olmalı (kullanıcı botlarının
#      webhook URL'i bu adres üzerine kurulur:
#      <NEXT_PUBLIC_SITE_URL>/api/telegram/user-webhook/<botId>).
#   4) components/SettingsPanel.jsx içindeki SITE_BOT_USERNAME sabitini
#      kendi site botunun kullanıcı adıyla değiştir (t.me/<bu-ad> linki
#      için — "bizim botumuza katıl" tek-tık deneyimi bunu kullanır).

